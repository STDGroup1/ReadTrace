# 阅迹 ReadTrace · 云函数环境变量（在云开发控制台给 rt-api 配上这些）
# 每一项都是可选的吗？不是 —— 下面标了[必填]的缺一个就不能用。

# ---- 鉴权（[必填]）----
# token 签名密钥：随便一串足够长的随机字符（40+ 位）。**没有兜底值**，
# 不配的话所有需要登录的接口一律拒绝 —— 宁可整体拒绝服务，也不用公开密钥。
RT_TOKEN_SECRET=PUT_A_LONG_RANDOM_STRING_HERE
# 换密钥时的过渡：把旧值放这里，验签先试新再试旧（在途 token 自然过期，没人被踢下线）。
RT_TOKEN_SECRET_PREV=
# 管理员看反馈 / 批量发邀请码用的口令（自己定一串）。
RT_ADMIN_KEY=PUT_AN_ADMIN_KEY_HERE

# ---- 回信节奏（可选）----
# 一封信寄出多久之后才回（毫秒）。它同时是「等一会儿才来」的门槛，默认 20000。
RT_REPLY_DELAY_MS=20000

# ---- 反馈信投递（可选：不配就只落库、不发信）----
# 注意 RT_SMTP_PASS 填的是**邮箱的 SMTP 授权码**，不是登录密码。
RT_SMTP_USER=
RT_SMTP_PASS=
RT_MAIL_TO=
RT_SMTP_HOST=smtp.qq.com
RT_SMTP_PORT=
RT_SMTP_TIMEOUT=20000
